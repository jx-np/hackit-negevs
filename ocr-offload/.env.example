OCR_HTTP_ADDR=:8098
# Use PP-OCRv6_tiny/small/medium to select both models, or a single one:
# _det = text detection (locates text boxes), _rec = text recognition (reads them).
OCR_MODEL=PP-OCRv6_medium
OCR_MIN_SCORE=0.5
OCR_WORKERS=0
OCR_CPU_THREADS=4
OCR_MAX_QUEUE=64
OCR_API_KEY=
OCR_MAX_IMAGE_BYTES=10485760
LOG_LEVEL=info
# Load the model in every worker at startup; slow first boot surfaces errors immediately. Set false to skip.
OCR_WARMUP=true
# Select onnxruntime to use the ONNX backend; empty keeps Paddle as default.
OCR_ENGINE=
# Set explicit dirs or a root containing <model>_det_onnx and <model>_rec_onnx.
OCR_ONNX_DET_DIR=
OCR_ONNX_REC_DIR=
OCR_ONNX_MODEL_ROOT=
# 0 uses OCR_CPU_THREADS; ORT inter-op 0 keeps its default.
OCR_ORT_INTRA_OP_THREADS=0
OCR_ORT_INTER_OP_THREADS=0
# 0 leaves PaddleOCR's recognition batch default unchanged.
OCR_REC_BATCH_SIZE=0
