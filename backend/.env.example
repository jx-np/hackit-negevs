# Copy to .env and fill in real values. .env is gitignored.
# Connection string for the PostgreSQL database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scamshield?sslmode=disable
# Address the HTTP server listens on.
HTTP_ADDR=:8080
# Secret used to sign JWT access tokens. MUST be set to a strong value outside development.
JWT_SECRET=dev-insecure-secret-change-me
# development | staging | production
APP_ENV=development
# Log format. Leave false/unset for the readable console format; set to true to
# emit machine-readable JSON lines (one object per line) for log ingestion.
PRODUCTION=false
# Access token lifetime (Go duration, e.g. 15m).
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime (Go duration, e.g. 720h = 30 days).
REFRESH_TOKEN_TTL=720h
# bcrypt work factor.
BCRYPT_COST=12
# Root directory for the local blob store holding uploaded screenshots and
# their PII-redacted derivatives. Created on startup if missing.
STORAGE_DIR=./data/uploads
# Base URL of the Python AI service (e.g. http://localhost:8000). It hosts both
# PII redaction (POST /v1/redact) for screenshot uploads and scam classification
# (POST /v1/classify) for text detection.
# Leave empty to use the built-in stub redactor (screenshot checks fail cleanly
# without redacting) and to disable classification (text detection then fails);
# the local rules analyzer has been removed.
PII_SERVICE_URL=http://127.0.0.1:8375
# Background retention reaper. When enabled it periodically deletes expired
# private checks/uploads (24h for uploads, 30d for checks, per the schema) and
# purges their stored blobs. Set to false to disable.
REAPER_ENABLED=true
# How often the retention reaper runs (Go duration, e.g. 1h).
REAPER_INTERVAL=1h
