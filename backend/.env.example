# Copy to .env and fill in real values. .env is gitignored.
# Connection string for the PostgreSQL database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scamshield?sslmode=disable
# Address the HTTP server listens on.
HTTP_ADDR=:8080
# Secret used to sign JWT access tokens. MUST be set to a strong value outside development.
JWT_SECRET=dev-insecure-secret-change-me
# development | staging | production
APP_ENV=development
# Access token lifetime (Go duration, e.g. 15m).
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime (Go duration, e.g. 720h = 30 days).
REFRESH_TOKEN_TTL=720h
# bcrypt work factor.
BCRYPT_COST=12
