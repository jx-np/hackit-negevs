# ScamWatch AI service — environment configuration.
# Copy to `.env` and adjust. Real environment variables win over this file.
# NEVER put secrets or model weights in git.

# Address the FastAPI server binds (host:port or :port).
AI_HTTP_ADDR=:8099

# SGLang clef-flash server. Call the SGLang server DIRECTLY, not via a gateway —
# /v1/systemone may not be reachable through the model gateway.
CLEF_BASE_URL=http://localhost:30000
CLEF_MODEL=Cloudflare/clef-flash
CLEF_TIMEOUT_SECONDS=30

# OCR (CPU). PaddleOCR 3.x text-recognition model name (note the _rec suffix):
# PP-OCRv6_tiny_rec, PP-OCRv6_small_rec, or PP-OCRv6_medium_rec.
OCR_MODEL=PP-OCRv6_small_rec
# Drop OCR boxes below this recognition confidence before the PII decision.
OCR_MIN_SCORE=0.5

# Min clef true-probability to treat an OCR box as PII.
PII_THRESHOLD=0.5

# Min clef true-probability for a classification signal to fire.
SIGNAL_THRESHOLD=0.5

# Verdict score thresholds (clef score is 0.0–2.0 over [likely_safe, unclear, suspicious]).
# score < VERDICT_LOW -> likely_safe; < VERDICT_HIGH -> unclear; else suspicious.
VERDICT_LOW=0.67
VERDICT_HIGH=1.34

# Logging verbosity. Never raise to a level that could leak content.
LOG_LEVEL=info
